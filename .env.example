# =========================================================================
# BLIND SPOT — Environment Variables Template (.env.example)
# =========================================================================

# Google Gemini API Key (Required for AI operations)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g. gemini-3.5-flash-lite, gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Port (Defaults to 8080 or process.env.PORT)
PORT=8080

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed CORS origins (comma-separated list, e.g. https://my-app.vercel.app,https://my-app.onrender.com; '*' is disallowed in production)
CORS_ORIGIN=*

# Rate Limiting Configuration (Optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Frontend Backend API Target (Optional, for standalone Vercel frontend deployments)
# Leave empty or unset when frontend & backend are served from the same domain
VITE_API_URL=
