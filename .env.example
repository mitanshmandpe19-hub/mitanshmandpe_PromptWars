# Google Gemini API Key (Required for AI operations)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Port (Defaults to 8080 or process.env.PORT)
PORT=8080

# Node Environment
NODE_ENV=development

# Allowed CORS origin (e.g. https://your-domain.com or * for dev)
CORS_ORIGIN=*
